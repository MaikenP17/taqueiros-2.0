# Solo NOMBRES de variables. Los valores van en:
#   * Vercel -> Project -> Settings -> Environment Variables  (produccion)
#   * un archivo .env local (ignorado por git) o variables de la sesion,
#     SOLO si vas a correr los scripts de supabase/ en tu computador.
# Nunca pongas un valor real en este archivo: el repositorio es publico.

# --- Supabase ---------------------------------------------------
SUPABASE_URL=
# Llave de servicio. Acepta la secreta nueva (sb_secret_...) o la
# service_role legacy. El mismo nombre sirve para las dos.
SUPABASE_SERVICE_ROLE_KEY=
# Recomendada. La publishable es publica (el front la lee de supabase-publico.js). La usan
# supabase/probar-menu-rls.js y api/_sesion.js (lo que valida las sesiones del panel, p. ej.
# api/reembolso.js) en la cabecera apikey al preguntarle a Supabase Auth quien es el dueno de
# una sesion; el token del usuario va en Authorization. Si no esta, usa la llave de servicio.
SUPABASE_PUBLISHABLE_KEY=

# --- Multi-restaurante ------------------------------------------
# Dominio base para resolver restaurantes por subdominio:
#   DOMINIO_BASE=midominio.com  ->  lostaqueiros.midominio.com = restaurante con slug 'lostaqueiros'
# Opcional: sin esta variable solo cuentan los dominios de la tabla restaurante_dominios.
DOMINIO_BASE=
# VERCEL_ENV lo pone Vercel solo ('production' | 'preview' | 'development'); con 'production' el
# parametro ?r=<slug> esta apagado. No la definas a mano.

# --- Wompi (pagos) y WhatsApp: RESPALDO SOLO PARA TAQUEIROS -----------
# Cada restaurante tiene sus llaves en la tabla restaurante_secretos (ver
# supabase/cargar-secretos.mjs). Estas variables son el respaldo de TAQUEIROS mientras no las cargue
# alla (se usa con un aviso en el log) y nunca valen para otro restaurante.
WOMPI_INTEGRITY_SECRET_TEST=
WOMPI_INTEGRITY_SECRET_PROD=
WOMPI_EVENTS_SECRET_TEST=
WOMPI_EVENTS_SECRET_PROD=
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
# Solo para supabase/cargar-secretos.mjs (opcionales; no las necesita el servidor):
# WOMPI_PUBLIC_KEY_TEST= / WOMPI_PUBLIC_KEY_PROD= / WOMPI_PRIVATE_KEY_TEST= / WOMPI_PRIVATE_KEY_PROD=
# WOMPI_MODO=test|produccion   (el modo de cobro lo decide el servidor)

# --- Crons (/api/alertas y /api/keep-alive) ---------------------
CRON_SECRET=
