{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/publico.js": {
      "includeFiles": "{index,pedido}.html"
    }
  },
  "headers": [
    {
      "source": "/superadmin.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://pzryobpriyewlxltditw.supabase.co; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/superadmin.js",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/superadmin-alta.js",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/superadmin-detalle.js",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/superadmin-lectura.js",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/superadmin-inicio.js",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/superadmin.css",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|TelegramBot|Twitterbot|Slackbot|Slack-ImgProxy|LinkedInBot|Discordbot).*" }],
      "destination": "/api/publico?_ruta=vista-previa&_pagina=index",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|TelegramBot|Twitterbot|Slackbot|Slack-ImgProxy|LinkedInBot|Discordbot).*" }],
      "destination": "/api/publico?_ruta=vista-previa&_pagina=index",
      "permanent": false
    },
    {
      "source": "/pedido.html",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(WhatsApp|facebookexternalhit|Facebot|meta-externalagent|meta-externalfetcher|TelegramBot|Twitterbot|Slackbot|Slack-ImgProxy|LinkedInBot|Discordbot).*" }],
      "destination": "/api/publico?_ruta=vista-previa&_pagina=pedido",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/manifest.json", "destination": "/api/publico?_ruta=manifest" },
    { "source": "/api/menu", "destination": "/api/publico?_ruta=menu" },
    { "source": "/api/estado", "destination": "/api/publico?_ruta=estado" },
    { "source": "/api/disponibilidad", "destination": "/api/publico?_ruta=disponibilidad" },
    { "source": "/api/restaurante", "destination": "/api/publico?_ruta=restaurante" },
    { "source": "/api/manifest", "destination": "/api/publico?_ruta=manifest" },
    { "source": "/api/alertas", "destination": "/api/cron?_ruta=alertas" },
    { "source": "/api/keep-alive", "destination": "/api/cron?_ruta=keep-alive" }
  ]
}
